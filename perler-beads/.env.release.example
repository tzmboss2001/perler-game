# 提审环境示例（请复制为 .env.production 或按CI注入）
VITE_AD_MODE=douyin
VITE_API_BASE_URL=https://your-api-domain.example.com

# 抖音广告位 ID
VITE_DOUYIN_REWARDED_AD_UNIT_ID=your_rewarded_ad_unit_id
VITE_DOUYIN_BANNER_CREATE_INLINE_ID=your_create_banner_id
VITE_DOUYIN_BANNER_MAKING_BOTTOM_ID=your_making_banner_id

# 可选：网页 fallback 广告（抖音提审不使用）
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_CREATE_INLINE=
VITE_ADSENSE_SLOT_MAKING_BOTTOM=

# 每日免费高清导出次数
VITE_HD_EXPORT_FREE_PER_DAY=1
